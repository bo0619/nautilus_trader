{
  "description": "Data-generation configuration for real Binance AFML bars using causal rolling daily density control.",
  "real_data": {
    "script": "binance_scripts/generate_afml_drb_from_aggtrades.py",
    "symbols": ["BTCUSDT.P"],
    "calibration_start": "2025-01-01",
    "calibration_end": "2025-01-31",
    "generation_start": "2025-02-01",
    "generation_end": "2026-05-31",
    "product": "um",
    "target_bars_per_day": 1440,
    "ewma_span_candidates": [20, 50, 100],
    "scale_search_iterations": 6,
    "scale_search_damping": 0.8,
    "imbalance_floor_frac": 0.01,
    "adaptive_density": false,
    "update_expected_ticks": false,
    "rolling_density": {
      "enabled": true,
      "activity_half_life_days": 7.0,
      "error_half_life_days": 7.0,
      "feedback_gain": 0.2,
      "max_daily_scale_change": 0.1,
      "min_scale": 0.25,
      "max_scale": 4.0,
      "activity_clip_min_ratio": 0.25,
      "activity_clip_max_ratio": 4.0,
      "density_error_clip_ratio": 4.0
    },
    "download": {
      "period_mode": "monthly",
      "workers": 32,
      "job_workers": 4,
      "chunk_mb": 8,
      "retries": 8,
      "timeout": 120.0
    },
    "incremental": {
      "enabled": true,
      "end_policy": "last_complete_month",
      "download_start_fallback": "2025-01-01",
      "generation_start_fallback": "2025-02-01"
    },
    "input_dir": "binance_scripts/data",
    "output_dir": "binance_scripts/data/afml_bars",
    "catalog_dir": "binance_scripts/data/afml_catalog",
    "calibration_output_dir": "binance_scripts/data/afml_bar_calibration",
    "tick_cache_dir": "binance_scripts/data/afml_tick_cache",
    "use_tick_cache": true,
    "write_catalog": true,
    "resume_calibration": true,
    "resume_completed_csv": true,
    "backup_existing_catalog": true,
    "tick_cache_schema_version": "1",
    "tick_cache_write_batch_size": 500000,
    "tick_cache_read_batch_size": 250000
  }
}
