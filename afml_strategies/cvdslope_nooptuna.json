{
  "name": "cvdslope",
  "description": "Shared CVD slope strategy hyperparameters for real-data and synthetic-path AFML backtests.",
  "event_definition": {
    "trend_window_bars": 20,
    "micro_slope_window_bars": 5,
    "cvd_z_window_bars": 200,
    "min_event_gap_bars": 1,
    "long": {
      "r2_threshold": 0.52,
      "cvd_z_min": 1.7,
      "micro_slope_min": 0.0
    },
    "short": {
      "r2_threshold": 0.44,
      "cvd_z_max": -1.2,
      "micro_slope_max": 0.0
    }
  },
  "barrier_optimization": {
    "enabled": true,
    "vertical_barrier_bars": 80,
    "barrier_unit": "ewma_1bar_log_return_volatility",
    "volatility_ewma_span": 80,
    "payoff_policy": "first_touch_or_terminal_log_return",
    "tie_policy": "stop_loss_first"
  },
  "meta_model": {
    "kind": "sequential_bagged_random_forest_classifier",
    "n_estimators": 100,
    "max_features": 1,
    "max_samples": "avg_uniqueness",
    "min_samples_leaf": 5,
    "min_weight_fraction_leaf": 0.05,
    "max_depth": null,
    "class_weight": "balanced_subsample",
    "class_probability_threshold": 0.5,
    "n_splits": 5,
    "embargo_bars": 800,
    "n_jobs": 8,
    "progress_interval": 1,
    "pca_components": 0.95,
    "pca_random_state": 42,
    "feature_selection": {
      "enabled": true,
      "top_n": 32,
      "mda_repeats": 3,
      "sfi_n_estimators": 10,
      "mda_prune_negative": true,
      "mda_pruning_validation_fraction": 0.25
    },
    "bet_size_step": 0.1
  },
  "real_data_workflow": {
    "output_dir": "afml_strategies/output/cvdslope_main",
    "data_start": "2025-01-01",
    "data_end": "2026-05-31",
    "train_start": "2025-01-01",
    "train_end": "2025-12-31",
    "test_start": "2026-02-01",
    "test_end": "2026-05-31",
    "run_backtest": true,
    "show_progress": true
  },
  "real_data_labeling": {
    "volatility_ewma_span": 80,
    "volatility_floor_quantile": 0.05,
    "cusum_window": 100,
    "cusum_threshold_mult": 3.0,
    "cusum_floor_quantile": 0.1,
    "min_ret": 0.0,
    "oldest_weight": 1.0,
    "rare_label_min_pct": null,
    "meta_label_min_ret": null
  },
  "feature_engineering": {
    "fracdiff_d": 0.4,
    "fracdiff_threshold": 0.01,
    "microstructure_window": 50,
    "information_window": 64,
    "calendar_windows": [
      "1D",
      "3D",
      "7D",
      "14D",
      "30D"
    ],
    "calendar_min_periods": 8,
    "tail_quantile": 0.99,
    "robust_z_clip": 5.0
  },
  "backtest": {
    "trade_notional": "10000",
    "starting_balance": "1000000",
    "default_leverage": "20",
    "confidence_threshold": 0.0,
    "min_position_change": "size_increment",
    "log_level": "ERROR"
  },
  "synthetic_labeling": {
    "n_paths_per_event": 25000,
    "event_batch_size": 16,
    "slippage_per_side_rate": 0.0002,
    "maker_fee_rate": 0.0002,
    "taker_fee_rate": 0.0005,
    "fee_liquidity": "taker",
    "label_threshold": 0.0,
    "candidate_export_top_n": 2,
    "random_seed": 1729
  },
  "primary_optuna": {
    "enabled": false,
    "n_trials": 5,
    "n_paths_per_event": 6400,
    "min_primary_events": 50,
    "min_accepted_events": 10,
    "random_seed": 1729,
    "search_space": {
      "long_R2": {
        "low": 0.4,
        "high": 0.7
      },
      "short_R2": {
        "low": 0.35,
        "high": 0.65
      },
      "long_Z": {
        "low": 1.0,
        "high": 2.5
      },
      "short_Z": {
        "low": -2.2,
        "high": -0.8
      },
      "long_PT": {
        "low": 0.5,
        "high": 4.0
      },
      "long_SL": {
        "low": 0.5,
        "high": 4.0
      },
      "short_PT": {
        "low": 0.5,
        "high": 4.0
      },
      "short_SL": {
        "low": 0.5,
        "high": 4.0
      }
    }
  },
  "sequential_bagging": {
    "sample_length_multiplier": 1.0,
    "random_seed": 2027
  },
  "runtime_strategy": {
    "source": "static", 
    "long_profit_taking_mult": 1.2,  
    "long_stop_loss_mult": 1.5,      
    "short_profit_taking_mult": 1.2, 
    "short_stop_loss_mult": 1.5,     
    "vertical_barrier_bars": 80,
    "vertical_barrier_days": null
  },
  "output_dir": "afml_scripts/output/ou_synthetic/ml_backtest"
}
